  "description": "Lightstreamer overview dashboard inspired by the RabbitMQ management overview.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "doc",
      "tags": [],
      "targetBlank": true,
      "title": "Lightstreamer documentation",
      "tooltip": "",
      "type": "link",
      "url": "https://www.lightstreamer.com/docs/"
    }
  ],
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Current number of active client sessions across all Adapter Sets.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(lightstreamer_AdapterSet_CurrentSessions)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
